-- 1. Dine-In Tables Entity
CREATE TABLE TablesEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tableNumber TEXT NOT NULL UNIQUE,
    capacity INTEGER NOT NULL DEFAULT 4,
    status TEXT NOT NULL DEFAULT 'AVAILABLE'
);

-- 2. Menu Items Entity (Food Catalog)
CREATE TABLE MenuItemsEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    itemName TEXT NOT NULL,
    price REAL NOT NULL,
    category TEXT NOT NULL DEFAULT 'General'
);

-- 3. Main Orders Table (Dine-In + Takeaway + History)
CREATE TABLE OrdersEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tableId INTEGER,
    orderType TEXT NOT NULL,
    totalAmount REAL NOT NULL DEFAULT 0.0,
    orderStatus TEXT NOT NULL DEFAULT 'PENDING',
    createdAt INTEGER NOT NULL
);

-- 4. Order Detail Items Entity
CREATE TABLE OrderItemsEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    orderId INTEGER NOT NULL,
    menuItemId INTEGER NOT NULL,
    itemName TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    price REAL NOT NULL,
    FOREIGN KEY (orderId) REFERENCES OrdersEntity(id) ON DELETE CASCADE
);

------------------ QUERIES ------------------

-- Table Queries
getAllTables:
SELECT * FROM TablesEntity ORDER BY id ASC;

insertTable:
INSERT OR REPLACE INTO TablesEntity(tableNumber, capacity, status) VALUES (?, ?, 'AVAILABLE');

updateTableStatus:
UPDATE TablesEntity SET status = ? WHERE id = ?;

deleteTable:
DELETE FROM TablesEntity WHERE id = ?;

-- Menu Catalog Queries
getAllMenuItems:
SELECT * FROM MenuItemsEntity;

insertMenuItem:
INSERT OR REPLACE INTO MenuItemsEntity(itemName, price, category) VALUES (?, ?, ?);

-- Active Order Queries
getPendingOrderForTable:
SELECT * FROM OrdersEntity WHERE tableId = ? AND orderStatus = 'PENDING' LIMIT 1;

createNewOrder:
INSERT INTO OrdersEntity(tableId, orderType, totalAmount, orderStatus, createdAt)
VALUES (?, ?, ?, 'PENDING', ?);

-- Order Items Queries
getOrderItemsForOrder:
SELECT * FROM OrderItemsEntity WHERE orderId = ?;

addOrderItem:
INSERT INTO OrderItemsEntity(orderId, menuItemId, itemName, quantity, price)
VALUES (?, ?, ?, ?, ?);

updateOrderItemQuantity:
UPDATE OrderItemsEntity SET quantity = ? WHERE id = ?;

deleteOrderItem:
DELETE FROM OrderItemsEntity WHERE id = ?;

-- Checkout Queries
completeOrder:
UPDATE OrdersEntity SET orderStatus = 'COMPLETED', totalAmount = ? WHERE id = ?;

-- History & Filtering Queries
getOrdersHistoryByDateRange:
SELECT * FROM OrdersEntity
WHERE orderStatus = 'COMPLETED' AND createdAt >= ? AND createdAt <= ?
ORDER BY createdAt DESC;

getDailySalesTotal:
SELECT SUM(totalAmount) FROM OrdersEntity
WHERE orderStatus = 'COMPLETED' AND createdAt >= ?;