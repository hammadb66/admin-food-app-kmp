    -- 1. Dine-In Tables Entity
    CREATE TABLE TablesEntity (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        tableNumber TEXT NOT NULL UNIQUE,
        capacity INTEGER NOT NULL DEFAULT 4,
        status INTEGER NOT NULL DEFAULT 0
    );

    -- 2. Menu Items Entity (Food Catalog)
    CREATE TABLE GenralItemsEntity (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        itemName TEXT NOT NULL,
        price REAL NOT NULL,
        category TEXT NOT NULL DEFAULT 'General'
    );

    -- 3. Main Orders Table (Dine-In + Takeaway + History)
CREATE TABLE OrdersEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tableId INTEGER,
    customerName TEXT NOT NULL,
    customerNumber INTEGER NOT NULL,
    orderType INTEGER NOT NULL,
    subtotal REAL NOT NULL DEFAULT 0.0,
    discountType INTEGER NOT NULL DEFAULT 0,
    discountValue REAL NOT NULL DEFAULT 0.0,
    discountAmount REAL NOT NULL DEFAULT 0.0,
    totalAmount REAL NOT NULL DEFAULT 0.0,
    orderStatus INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    createdByID INTEGER NOT NULL DEFAULT 0,
    createdByName TEXT NOT NULL DEFAULT 'Admin'
);

    -- 4. Order Detail Items Entity
    CREATE TABLE OrderItemsEntity (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        orderId INTEGER NOT NULL,
        menuItemId INTEGER NOT NULL,
        itemName TEXT NOT NULL,
        quantity INTEGER NOT NULL DEFAULT 1,
        printedQuantity INTEGER NOT NULL DEFAULT 0,
        price REAL NOT NULL,
        FOREIGN KEY (orderId) REFERENCES OrdersEntity(id) ON DELETE CASCADE
    );


    -- 2. New Void/Cancellation Audit Log Table (Chori pakadne ke liye)
    CREATE TABLE VoidLogsEntity (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        orderId INTEGER NOT NULL,
        itemName TEXT NOT NULL,
        cancelledQuantity INTEGER NOT NULL,
        unitPrice REAL NOT NULL,
        reason TEXT NOT NULL DEFAULT 'Item Cancelled',
        createdAt INTEGER NOT NULL,
        voidByID INTEGER NOT NULL DEFAULT 0,
        voidedByName TEXT NOT NULL DEFAULT 'Admin',
        customerName TEXT NOT NULL DEFAULT 'NOT SPECIFIED'
    );


CREATE TABLE UserEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL,
    isAdmin INTEGER NOT NULL DEFAULT 0, -- 0 = Normal User, 1 = Admin
    userAccess INTEGER NOT NULL DEFAULT 0
);
    ------------------ QUERIES ------------------

    -- Table Queries
    getAllTables:
    SELECT * FROM TablesEntity ORDER BY id ASC;

    insertTable:
    INSERT OR REPLACE INTO TablesEntity(tableNumber, capacity, status) VALUES (?, ?, 0);

    updateTableStatus:
    UPDATE TablesEntity SET status = ? WHERE id = ?;

    deleteTable:
    DELETE FROM TablesEntity WHERE id = ?;

    -- Menu Catalog Queries
    getAllMenuItems:
    SELECT * FROM GenralItemsEntity;

    getPendingTakeawayOrNullOrders:
    SELECT * FROM OrdersEntity
    WHERE orderStatus = 0 AND (tableId IS NULL OR tableId = 0);


    insertMenuItem:
    INSERT OR REPLACE INTO GenralItemsEntity(itemName, price, category) VALUES (?, ?, ?);

    deleteGeneralItem:
    DELETE FROM GenralItemsEntity WHERE id=?;

    updateTable:
    UPDATE TablesEntity SET tableNumber = ?, capacity = ? WHERE id = ?;


    updateOrderCustomerInfo:
    UPDATE OrdersEntity SET customerName=?,customerNumber=? WHERE id=?;


    updateGeneralItem:
    UPDATE GenralItemsEntity SET itemName = ?, price = ? WHERE id = ?;
    -- Active Order Queries
    getPendingOrderForTable:
    SELECT * FROM OrdersEntity WHERE tableId = ? AND orderStatus = 0 LIMIT 1;


    getPendingOrderForTakeAway:
    SELECT * FROM OrdersEntity WHERE orderStatus = 0 AND orderType = 1 LIMIT 1;

    createNewOrder:
    INSERT INTO OrdersEntity(tableId,customerName,customerNumber, orderType, totalAmount, orderStatus, createdAt,createdByID,createdByName)
    VALUES (?,?,?, ?, ?, 0, ?,?,?);
    getOrderById:
    SELECT * FROM OrdersEntity WHERE id = ? AND orderStatus = 0 LIMIT 1;
    -- Order Items Queries
    getOrderItemsForOrder:
    SELECT * FROM OrderItemsEntity WHERE orderId = ?;

    addOrderItem:
    INSERT INTO OrderItemsEntity(orderId, menuItemId, itemName, quantity, price)
    VALUES (?, ?, ?, ?, ?);

    updateOrderItemQuantity:
    UPDATE OrderItemsEntity SET quantity = ? WHERE id = ?;

    deleteOrderItem:
    DELETE FROM OrderItemsEntity WHERE id = ?;

    -- Checkout Queries
    completeOrder:
    UPDATE OrdersEntity
    SET orderStatus = 1,  subtotal = :subtotal,discountType = :discountType,discountValue = :discountValue,discountAmount = :discountAmount,totalAmount = :totalAmount WHERE id = :id;

    -- History & Filtering Queries
    getOrdersHistoryByDateRange:
    SELECT * FROM OrdersEntity
    WHERE orderStatus = 1 AND createdAt >= ? AND createdAt <= ?
    ORDER BY createdAt DESC;

    getDailySalesTotal:
    SELECT SUM(totalAmount) FROM OrdersEntity
    WHERE orderStatus = 1 AND createdAt >= ?;


    -- Save Void Audit Entry
    insertVoidLog:
    INSERT INTO VoidLogsEntity(orderId, itemName, cancelledQuantity, unitPrice, reason, createdAt,voidByID,voidedByName,customerName)
    VALUES (?, ?, ?, ?, ?, ?,?,?,?);

    -- Owner Audit Report Query (Daily Cancellations)
    getDailyVoidLogs:
    SELECT * FROM VoidLogsEntity WHERE createdAt >= ? ORDER BY createdAt DESC;

    -- Update Printed Quantity after Printing
    updatePrintedQuantity:
    UPDATE OrderItemsEntity SET printedQuantity = quantity WHERE orderId = ?;



    getLastInsertedOrderId:
    SELECT last_insert_rowid();


    -- Date Range + Multi Search (Name, Phone, Table ID) ke mutabiq orders get karein
    getOrdersHistory:
    SELECT * FROM OrdersEntity
    WHERE createdAt >= :startOfDay AND createdAt <= :endOfDay
    AND (
        customerName LIKE '%' || :searchQuery || '%'
        OR customerNumber LIKE '%' || :searchQuery || '%'
        OR CAST(COALESCE(tableId, 0) AS TEXT) LIKE '%' || :searchQuery || '%'
    )
    ORDER BY createdAt DESC;

    -- Date Range ke mutabiq Void Audit Logs get karein
    getVoidLogsHistory:
    SELECT * FROM VoidLogsEntity
    WHERE createdAt >= :startOfDay AND createdAt <= :endOfDay
    ORDER BY createdAt DESC;





    -- 1. Username se User dhoondna
    getUserByName:
    SELECT * FROM UserEntity WHERE name = :name;

    -- 2. User ID se User dhoondna
    getUserById:
    SELECT * FROM UserEntity WHERE id = :id;

    -- 3. Sare Users ki list
    getAllUsers:
    SELECT * FROM UserEntity;

    -- 4. Naya User insert karna
    insertUser:
    INSERT INTO UserEntity(name, password, isAdmin, userAccess)
    VALUES (?, ?, ?, ?);

    -- 5. User Edit / Access Update karna
    updateUserAccess:
    UPDATE UserEntity
    SET name = :name, password = :password, isAdmin = :isAdmin, userAccess = :userAccess
    WHERE id = :id;

    -- 6. User Delete karna
    deleteUserById:
    DELETE FROM UserEntity WHERE id = :id;

    -- 7. Count check karna (Auto-Admin Seeding ke liye)
    getUsersCount:
    SELECT COUNT(*) FROM UserEntity;



    -- ================================================================
    -- BACKUP / RESTORE QUERIES (for JSON export/import)
    -- ================================================================

    getAllOrdersRaw:
    SELECT * FROM OrdersEntity;

    getAllOrderItemsRaw:
    SELECT * FROM OrderItemsEntity;

    getAllVoidLogsRaw:
    SELECT * FROM VoidLogsEntity;

    -- Clear everything (order matters: children first)
    deleteAllOrderItems:
    DELETE FROM OrderItemsEntity;

    deleteAllVoidLogs:
    DELETE FROM VoidLogsEntity;

    deleteAllOrders:
    DELETE FROM OrdersEntity;

    deleteAllMenuItems:
    DELETE FROM GenralItemsEntity;

    deleteAllTables:
    DELETE FROM TablesEntity;

    deleteAllUsers:
    DELETE FROM UserEntity;

    -- Restore with explicit IDs
    restoreTable:
    INSERT INTO TablesEntity(id, tableNumber, capacity, status)
    VALUES (?, ?, ?, ?);

    restoreMenuItem:
    INSERT INTO GenralItemsEntity(id, itemName, price, category)
    VALUES (?, ?, ?, ?);

    restoreOrder:
    INSERT INTO OrdersEntity(
        id, tableId, customerName, customerNumber, orderType,
        subtotal, discountType, discountValue, discountAmount,
        totalAmount, orderStatus, createdAt, createdByID, createdByName
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

    restoreOrderItem:
    INSERT INTO OrderItemsEntity(
        id, orderId, menuItemId, itemName, quantity, printedQuantity, price
    ) VALUES (?, ?, ?, ?, ?, ?, ?);

    restoreVoidLog:
    INSERT INTO VoidLogsEntity(
        id, orderId, itemName, cancelledQuantity, unitPrice,
        reason, createdAt, voidByID, voidedByName, customerName
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

    restoreUser:
    INSERT INTO UserEntity(id, name, password, isAdmin, userAccess)
    VALUES (?, ?, ?, ?, ?);